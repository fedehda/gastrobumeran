# ==============================================================================
# GASTROBUMERAN - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo a `.env.local` para sobrescribir credenciales locales sin subirlas a Git.

# ------------------------------------------------------------------------------
# 0. MODO DE EJECUCIÓN (UNIFIED CODEBASE: OFFLINE vs. CLOUD SAAS)
# ------------------------------------------------------------------------------
# APP_MODE=offline   -> Modo Monousuario / Servidor Local en PC del negocio:
#                       Fija restaurant_id al local demo, usa SQLite local,
#                       muestra el POS directo en '/', oculta landing/registro SaaS.
# APP_MODE=cloud     -> Modo Multi-Tenant Cloud SaaS (default):
#                       Muestra landing comercial en '/', registro de restaurantes en
#                       '/registro', y acceso multi-tenant aislado en '/r/[slug]'.
#
# SINGLE_TENANT=true -> Alias booleano para activar el modo local offline.
APP_MODE=cloud
SINGLE_TENANT=false

# (Opcional en modo offline) Identificador y slug del restaurante local:
LOCAL_RESTAURANT_ID=resto-demo-default
LOCAL_RESTAURANT_SLUG=demo

# ------------------------------------------------------------------------------
# 1. Credenciales de la API Pública de Fudo POS (Sprint 3)
# ------------------------------------------------------------------------------
# Provistas por el restaurante desde el panel de Fudo (Administración > API).
# Si se omiten o inician con 'DEMO_', la plataforma utilizará el simulador Sandbox oficial.
FUDO_API_KEY=DEMO_FUDO_KEY_RESTO99
FUDO_API_SECRET=DEMO_FUDO_SECRET_XYZ888
FUDO_BASE_URL=https://api.fu.do/v1alpha1
FUDO_AUTH_URL=https://auth.fu.do/api

# ------------------------------------------------------------------------------
# 2. Seguridad de Tareas Programadas (Crons nocturnos)
# ------------------------------------------------------------------------------
# Token secreto para proteger los endpoints de ejecución de crons (/api/cron/*)
CRON_SECRET=gastrobumeran_secret_cron_key_2026

# ------------------------------------------------------------------------------
# 3. Base de Datos Productiva (PostgreSQL - Opcional en desarrollo)
# ------------------------------------------------------------------------------
# En desarrollo local por defecto se utiliza SQLite embebido en `data/gastrobumeran.sqlite`.
# Para producción (Supabase, Neon, AWS RDS, PostgreSQL 14+):
# DATABASE_URL=postgresql://usuario:password@localhost:5432/gastrobumeran
